<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="afl"
           fetch="https://github.com/AfterlifeOS"
           sync-c="true"
           sync-j="4"
           revision="16" />

  <remote  name="afl-gitea"
           fetch="https://gitea.com/AfterlifeOS"
           sync-c="true"
           sync-j="4"
           revision="16" />

  <!-- art -->
  <project path="art" name="art" groups="pdk" remote="afl" />

  <!-- bionic -->
  <project path="bionic" name="bionic" groups="pdk" remote="afl" />

  <!-- bootable -->
  <project path="bootable/deprecated-ota" name="bootable_deprecated-ota" groups="pdk-cw" remote="afl" />
  <project path="bootable/recovery" name="bootable_recovery" groups="pdk" remote="afl" />

  <!-- build -->
  <project path="build/make" name="build" groups="pdk,sysui-studio" remote="afl" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="build/release" name="build_release" groups="pdk,tradefed,sysui-studio" remote="afl" />
  <project path="build/soong" name="build_soong" groups="pdk,tradefed,sysui-studio" remote="afl" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- external -->
  <project path="external/bouncycastle" name="external_bouncycastle" groups="pdk" remote="afl" />
  <project path="external/cronet" name="external_cronet" groups="pdk" remote="afl" />
  <project path="external/robolectric" name="external_robolectric" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="afl" />
  <project path="external/skia" name="external_skia" groups="pdk,qcom_msm8x26" remote="afl" />

  <!-- frameworks -->
  <project path="frameworks/av" name="frameworks_av" groups="pdk" remote="afl" />
  <project path="frameworks/base" name="afterlife_frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="afl" />
  <project path="frameworks/libs/systemui" name="frameworks_libs_systemui" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="afl" />
  <project path="frameworks/native" name="frameworks_native" groups="pdk" remote="afl" />

  <!-- manifest -->
  <project path="manifest" name="afterlife_manifest" remote="afl" revision="16x" />

  <!-- packages -->
  <project path="packages/apps/BtHelper" name="packages_apps_BtHelper" remote="afl" />
  <project path="packages/apps/Contacts" name="packages_apps_Contacts" remote="afl" groups="pdk-fs" />
  <project path="packages/apps/Dialer" name="packages_apps_Dialer" remote="afl" />
  <project path="packages/apps/Messaging" name="packages_apps_Messaging" remote="afl" />
  <project path="packages/apps/GameSpace" name="packages_apps_GameSpace" groups="pdk-fs" remote="afl" />
