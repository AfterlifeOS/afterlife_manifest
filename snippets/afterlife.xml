  <project path="system/core" name="system_core" groups="pdk" remote="afl" />
  <project path="system/sepolicy" name="system_sepolicy" groups="pdk" remote="afl" />
  <project path="system/update_engine" name="system_update_engine" groups="pdk" remote="afl" />

  <!-- vendor -->
  <project path="vendor/afterlife" name="vendor_afterlife" remote="afl" />
  <project path="vendor/afterlife/signed" name="vendor_signed" remote="afl" />
  <project path="vendor/certification" name="vendor_certification" remote="afl" />
  <project path="vendor/extras" name="vendor_extras" remote="afl" />
  <project path="vendor/gms" name="vendor_gms" remote="afl-gitea" clone-depth="1" />
  <project path="vendor/support" name="vendor_support" remote="afl" />

</manifest>