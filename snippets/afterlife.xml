  <project path="packages/apps/FaceUnlock" name="packages_apps_FaceUnlock" remote="afl-gitea" />
  <project path="packages/apps/AfterHome" name="packages_apps_AfterHome" groups="pdk-fs,sysui-studio,pdk-cw-tvc" remote="afl" />
  <project path="packages/apps/Settings" name="afterlife_packages_apps_Settings" groups="pdk-fs,pdk-cw-tvc" remote="afl" />
  <project path="packages/apps/SettingsIntelligence" name="packages_apps_SettingsIntelligence" groups="pdk-fs" remote="afl" />
  <project path="packages/apps/ThemePicker" name="packages_apps_ThemePicker" groups="pdk-fs,sysui-studio" remote="afl" />
  <project path="packages/apps/TouchGestures" name="packages_apps_TouchGestures" remote="afl" />
  <project path="packages/apps/WallpaperPicker2" name="packages_apps_WallpaperPicker2" groups="pdk-fs,sysui-studio" remote="afl" />
  <project path="packages/inputmethods/LatinIME" name="packages_inputmethods_LatinIME" groups="pdk-fs" remote="afl" />
  <project path="packages/modules/Connectivity" name="packages_modules_Connectivity" groups="pdk-cw-fs,pdk-fs" remote="afl" />
  <project path="packages/services/Telecomm" name="packages_services_Telecomm" groups="pdk-cw-fs,pdk-fs" remote="afl" />

  <!-- prebuilts -->
  <project path="prebuilts/afterlife-sdk" name="prebuilts_afterlife-sdk" remote="afl" />

  <!-- sepolicy -->
  <project path="device/lineage/sepolicy" name="device_afterlife_sepolicy" remote="afl" />

