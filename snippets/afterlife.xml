  <remote  name="gitlab"
           fetch="https://gitlab.com/AfterlifeOS"
           sync-c="true"
           sync-j="4"
           revision="16-qpr2" />

  <remote  name="afterlife"
           fetch="https://github.com/AfterlifeOS"
           sync-c="true"
           sync-j="4"
           revision="16.2" />

           <remote  name="wg"
           fetch="https://github.com/afl-Workground"
           sync-c="true"
           sync-j="4"
           revision="wip" />

  <!-- art -->
  <project path="art" name="art" groups="pdk" remote="afterlife" />

  <!-- bionic -->
  <project path="bionic" name="bionic" groups="pdk" remote="afterlife" />

